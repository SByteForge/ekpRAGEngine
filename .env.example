POSTGRES_USER=ekp
POSTGRES_PASSWORD=ekp_local_dev
POSTGRES_DB=ekp
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ekp:ekp_local_dev@localhost:5432/ekp
 
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=ekp_chunks
 
OLLAMA_BASE_URL=http://localhost:11434
# Swap to "mistral" (or your local tag) here if llama3.1:8b is slow/not pulled -
# nothing else in the codebase needs to change.
OLLAMA_GEN_MODEL=mistral:latest
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_JUDGE_MODEL=gemma4:latest
 
API_KEY_SALT=change_me_local_only
JWT_SECRET=change_me_local_only
JWT_EXPIRE_MINUTES=120
 
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
 
RETRIEVAL_TOP_K_DENSE=20
RETRIEVAL_TOP_K_BM25=20
RETRIEVAL_TOP_K_FINAL=5
RERANK_MODEL=BAAI/bge-reranker-base
